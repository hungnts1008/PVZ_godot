[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "extends Camera2D

@onready var bg = get_parent().get_node(\"Sprite2D\")
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var screen_size = get_viewport_rect().size
	var bg_size = bg.texture.get_size() * bg.scale
	
	var zoom_x = screen_size.x / bg_size.x
	var zoom_y = screen_size.y / bg_size.y
	
	var zoom = max(zoom_x, zoom_y)
	
	self.zoom = Vector2(zoom, zoom)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

